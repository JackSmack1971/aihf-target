    },
    "max_data_staleness_ms": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_clock_skew_ms": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "protection_gap_ms": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "min_emergency_rate_limit_reserve": {
      "type": "number",
      "exclusiveMinimum": 0
