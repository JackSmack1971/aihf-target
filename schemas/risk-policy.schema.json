      "exclusiveMinimum": 0
    },
    "max_position_leverage": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_margin_utilization_pct": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_loss_at_invalidation_pct_nav": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_strategy_daily_loss_pct_nav": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_fund_daily_drawdown_pct_nav": {
