  "safe_state_runtime_mapping": {
    "REJECT_INPUT": {
      "runtime_states": [],
      "runtime_effect": "NO_STATE_CHANGE",
      "intent_effect": "REJECTED",
      "exposure_increase_allowed": false,
      "description": "Input rejected at the gateway; the TradeIntent becomes REJECTED; runtime state is unchanged."
    },
    "BLOCK_NEW_EXPOSURE": {
      "runtime_states": [
        "DEGRADED",
        "DISARMED",
        "SAFE_HALT"
      ],
      "runtime_effect": "DEGRADED_OR_STAY_NON_ARMED",
      "intent_effect": "NO_PERMIT_ISSUED",
      "exposure_increase_allowed": false,
      "description": "Runtime moves to DEGRADED or remains in a non-ARMED state; no exposure increase; risk-reducing action stays available."
    },
    "DEGRADED": {
      "runtime_states": [
        "DEGRADED"
      ],
      "runtime_effect": "ENTER_DEGRADED",
      "intent_effect": "NO_PERMIT_ISSUED",
      "exposure_increase_allowed": false,
      "description": "Runtime enters DEGRADED; recovery requires full reconcile."
    },
    "SAFE_HALT": {
      "runtime_states": [
        "SAFE_HALT"
      ],
      "runtime_effect": "ENTER_SAFE_HALT",
      "intent_effect": "NO_PERMIT_ISSUED",
      "exposure_increase_allowed": false,
      "description": "Runtime enters SAFE_HALT; only deterministic cancel/protect/risk-reducing actions, never dependent on an LLM."
    },
    "FAIL_CLOSED_REBUILD": {
      "runtime_states": [
        "SAFE_HALT"
      ],
      "runtime_effect": "ENTER_SAFE_HALT_THEN_REBUILD",
      "intent_effect": "NO_PERMIT_ISSUED",
      "exposure_increase_allowed": false,
      "description": "State is untrusted: SAFE_HALT, then rebuild from authoritative evidence before any recovery."
    },
    "DENY_CAPABILITY": {
      "runtime_states": [],
      "runtime_effect": "NO_STATE_CHANGE",
      "intent_effect": "REJECTED",
      "exposure_increase_allowed": false,
      "description": "The capability request is denied and logged; no runtime transition is required."
    },
    "RECONCILE_BEFORE_RETRY": {
      "runtime_states": [
        "DEGRADED"
      ],
      "runtime_effect": "ENTER_DEGRADED_UNTIL_RECONCILED",
      "intent_effect": "RECONCILING",
      "exposure_increase_allowed": false,
      "description": "No retry before authoritative reconciliation; exposure increase blocked meanwhile."
    }
