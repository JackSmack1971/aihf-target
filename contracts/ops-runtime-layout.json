{
  "schema_version": 1,
  "note": "Canonical OS layout of the isolated fund-ops runtime (Phase 1, slice P1-S2; decisions D-0007) extended in P1-S3A (D-0009) with the CONTRACT for the riskd, traderd and signerd service identities, their private state directories, the signerd-only secret directory and the root-owned fundctl. P1-S3A defined the contracts; P1-S3B (D-0009) realizes them as provisioning artifacts only (identities, directories, sentinel and the inert fundctl are written by the operator-run provisioner; nothing has been applied to a live system and no service exists). ops/provision/fund-ops-layout.sh mirrors the values and tests/conformance/ops-provision.test.mjs enforces parity. src/contracts/ops-layout-checker.mjs pins the invariants. The security properties come from managed Codex requirements, Unix identities and ownership, a root-owned release, and the absence of Windows interop, not from WSL itself; the Windows administrator/operator is Zone 0 trust (OD-5 accepted residual risk). The ops HOME is sticky and root-owned like the Codex home because documented user skill roots live under HOME. The signer sentinel is a fixed non-secret marker; no real secret material, key or seed exists in or is created from this contract.",
  "runtime": {
    "platform": "wsl2-ubuntu-dedicated-distro",
    "codex_version_pin": "0.160.1",
    "requirements_path": "/etc/codex/requirements.toml",
    "release_root": "/opt/aihf/releases",
    "release_current": "/opt/aihf/current",
    "toolchain_codex_bin": "/opt/aihf/toolchain/codex/bin/codex",
    "launcher": "/opt/aihf/bin/fund-ops",
    "launcher_path_env": "/usr/bin:/bin",
    "launcher_env_allowlist": [
      "CODEX_HOME",
      "HOME",
      "LANG",
      "PATH",
      "TERM"
    ],
    "runtime_state_root": "/var/lib/aihf/runtime",
    "ops_home": "/var/lib/aihf/ops/home",
    "codex_home": "/var/lib/aihf/ops/codex-home",
    "scratch": "/var/lib/aihf/runtime/scratch",
    "state": "/var/lib/aihf/runtime/state"
  },
  "identities": [
