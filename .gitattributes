# Byte-stable files: shell scripts and hash-pinned artifacts must keep LF endings on every checkout (core.autocrlf would otherwise break bash and the pinned hashes).
ops/provision/** text eol=lf
config/codex/*.toml text eol=lf
contracts/ops-runtime-layout.json text eol=lf
.codex/** text eol=lf

# fundctl is a byte-stable root-only script: LF endings on every checkout (its SHA-256 is pinned).
ops/fundctl/fundctl text eol=lf

# Live harness shell scripts run inside a Linux distro: LF endings on every checkout.
tests/live/*.sh text eol=lf
